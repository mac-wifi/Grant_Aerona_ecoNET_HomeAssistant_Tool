{

    "id": null,
    "uid": "econet-temperature",
    "title": "EcoNet Grant - Temperature",
    "tags": ["econet", "temperature"],
    "timezone": "browser",
    "schemaVersion": 39,
    "refresh": "5m",
    "time": {
      "from": "now-24h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "CH Thermostat and Day Setting",
        "datasource": { "type": "influxdb", "uid": "econet-influxdb" },
        "description": "Day setting is not necessarily the active target in Night/Schedule mode. Match entity IDs to your HA registry.",
        "type": "timeseries",
        "gridPos": { "h": 10, "w": 24, "x": 0, "y": 0 },
        "fieldConfig": {
          "defaults": {
            "unit": "celsius",
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10,
              "spanNulls": false
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "influxdb", "uid": "econet-influxdb" },
            "rawQuery": true,
            "resultFormat": "time_series",
            "alias": "$tag_entity_id",
            "query": "SELECT mean(\"value\") FROM \"°C\" WHERE $timeFilter AND ((\"domain\" = 'sensor' AND \"entity_id\" = 'grant_aerona_heat_pump_ch_thermostat') OR (\"domain\" = 'number' AND \"entity_id\" = 'grant_aerona_heat_pump_ch_day_temp')) GROUP BY time($__interval), \"domain\", \"entity_id\" fill(null)"
          }
        ]
      },
      {
        "id": 2,
        "title": "HW Temperature and Set Point",
        "datasource": { "type": "influxdb", "uid": "econet-influxdb" },
        "type": "timeseries",
        "gridPos": { "h": 10, "w": 12, "x": 0, "y": 10 },
        "fieldConfig": {
          "defaults": {
            "unit": "celsius",
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10,
              "spanNulls": false
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "influxdb", "uid": "econet-influxdb" },
            "rawQuery": true,
            "resultFormat": "time_series",
            "alias": "$tag_entity_id",
            "query": "SELECT mean(\"value\") FROM \"°C\" WHERE $timeFilter AND ((\"domain\" = 'sensor' AND \"entity_id\" = 'grant_aerona_heat_pump_hw_temperature') OR (\"domain\" = 'number' AND \"entity_id\" = 'grant_aerona_heat_pump_hw_set_point')) GROUP BY time($__interval), \"domain\", \"entity_id\" fill(null)"
          }
        ]
      },
      {
        "id": 3,
        "title": "Outdoor Temperature",
        "datasource": { "type": "influxdb", "uid": "econet-influxdb" },
        "type": "timeseries",
        "gridPos": { "h": 10, "w": 12, "x": 12, "y": 10 },
        "fieldConfig": {
          "defaults": {
            "unit": "celsius",
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10,
              "spanNulls": false
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "influxdb", "uid": "econet-influxdb" },
            "rawQuery": true,
            "resultFormat": "time_series",
            "alias": "$tag_entity_id",
            "query": "SELECT mean(\"value\") FROM \"°C\" WHERE $timeFilter AND (\"domain\" = 'sensor' AND \"entity_id\" = 'grant_aerona_heat_pump_outdoor_temperature') GROUP BY time($__interval), \"domain\", \"entity_id\" fill(null)"
          }
        ]
      },
      {
        "id": 4,
        "title": "Latest Setpoints in Selected Range",
        "datasource": { "type": "influxdb", "uid": "econet-influxdb" },
        "type": "stat",
        "gridPos": { "h": 6, "w": 24, "x": 0, "y": 20 },
        "fieldConfig": {
          "defaults": {
            "unit": "celsius",
            "thresholds": {
              "mode": "absolute",
              "steps": [
                { "color": "blue", "value": null },
                { "color": "green", "value": 15 },
                { "color": "orange", "value": 30 },
                { "color": "red", "value": 50 }
              ]
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "influxdb", "uid": "econet-influxdb" },
            "rawQuery": true,
            "resultFormat": "time_series",
            "alias": "$tag_entity_id",
            "query": "SELECT last(\"value\") FROM \"°C\" WHERE $timeFilter AND ((\"domain\" = 'number' AND \"entity_id\" = 'grant_aerona_heat_pump_ch_day_temp') OR (\"domain\" = 'number' AND \"entity_id\" = 'grant_aerona_heat_pump_hw_set_point')) GROUP BY \"domain\", \"entity_id\""
          }
        ]
      }
    ]
}
