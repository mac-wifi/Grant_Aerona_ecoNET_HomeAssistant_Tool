{

    "id": null,
    "uid": "econet-performance",
    "title": "EcoNet Grant - Performance",
    "tags": ["econet", "performance"],
    "timezone": "browser",
    "schemaVersion": 39,
    "refresh": "5m",
    "time": {
      "from": "now-24h",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Flow vs Return Temperature",
        "datasource": { "type": "influxdb", "uid": "econet-influxdb" },
        "type": "timeseries",
        "gridPos": { "h": 10, "w": 24, "x": 0, "y": 0 },
        "fieldConfig": {
          "defaults": {
            "unit": "celsius",
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10,
              "spanNulls": false
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "influxdb", "uid": "econet-influxdb" },
            "rawQuery": true,
            "resultFormat": "time_series",
            "alias": "$tag_entity_id",
            "query": "SELECT mean(\"value\") FROM \"°C\" WHERE $timeFilter AND ((\"domain\" = 'sensor' AND \"entity_id\" = 'grant_aerona_heat_pump_flow_temperature') OR (\"domain\" = 'sensor' AND \"entity_id\" = 'grant_aerona_heat_pump_return_temperature')) GROUP BY time($__interval), \"domain\", \"entity_id\" fill(null)"
          }
        ]
      },
      {
        "id": 2,
        "title": "Compressor Frequency",
        "datasource": { "type": "influxdb", "uid": "econet-influxdb" },
        "type": "timeseries",
        "gridPos": { "h": 10, "w": 12, "x": 0, "y": 10 },
        "fieldConfig": {
          "defaults": {
            "unit": "hertz",
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10,
              "spanNulls": false
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "influxdb", "uid": "econet-influxdb" },
            "rawQuery": true,
            "resultFormat": "time_series",
            "alias": "$tag_entity_id",
            "query": "SELECT mean(\"value\") FROM \"Hz\" WHERE $timeFilter AND (\"domain\" = 'sensor' AND \"entity_id\" = 'grant_aerona_heat_pump_compressor_frequency') GROUP BY time($__interval), \"domain\", \"entity_id\" fill(null)"
          }
        ]
      },
      {
        "id": 3,
        "title": "Pump Speed",
        "datasource": { "type": "influxdb", "uid": "econet-influxdb" },
        "type": "timeseries",
        "gridPos": { "h": 10, "w": 12, "x": 12, "y": 10 },
        "fieldConfig": {
          "defaults": {
            "unit": "rotrpm",
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10,
              "spanNulls": false
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "influxdb", "uid": "econet-influxdb" },
            "rawQuery": true,
            "resultFormat": "time_series",
            "alias": "$tag_entity_id",
            "query": "SELECT mean(\"value\") FROM \"rpm\" WHERE $timeFilter AND (\"domain\" = 'sensor' AND \"entity_id\" = 'grant_aerona_heat_pump_pump_speed') GROUP BY time($__interval), \"domain\", \"entity_id\" fill(null)"
          }
        ]
      },
      {
        "id": 4,
        "title": "Reading These Graphs",
        "type": "text",
        "gridPos": { "h": 5, "w": 24, "x": 0, "y": 20 },
        "options": {
          "mode": "markdown",
          "content": "These are HA entity states, not energy or COP measurements. Flow/return temperatures and compressor frequency alone do not establish efficiency. Missing or unavailable sensors produce gaps; do not treat gaps as zero. The former Flux join/differential example is omitted: no derived sensor or extra data source is assumed."
        }
      }
    ]
}
