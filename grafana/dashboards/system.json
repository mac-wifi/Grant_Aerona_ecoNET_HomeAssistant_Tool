{

    "id": null,
    "uid": "econet-system",
    "title": "EcoNet Grant - System",
    "tags": ["econet", "system"],
    "timezone": "browser",
    "schemaVersion": 39,
    "refresh": "1h",
    "time": {
      "from": "now-7d",
      "to": "now"
    },
    "panels": [
      {
        "id": 1,
        "title": "Work Mode Over Time",
        "datasource": { "type": "influxdb", "uid": "econet-influxdb" },
        "description": "Configured Summer/Winter/Auto mode, not compressor running state. Text states use the state field.",
        "type": "state-timeline",
        "gridPos": { "h": 8, "w": 24, "x": 0, "y": 0 },
        "fieldConfig": {
          "defaults": {
            "custom": {
              "fillOpacity": 70
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "influxdb", "uid": "econet-influxdb" },
            "rawQuery": true,
            "resultFormat": "table",
            "query": "SELECT \"state\" FROM \"state\" WHERE $timeFilter AND (\"domain\" = 'select' AND \"entity_id\" = 'grant_aerona_heat_pump_work_mode')"
          }
        ]
      },
      {
        "id": 2,
        "title": "Heat Source Preset Temperature",
        "datasource": { "type": "influxdb", "uid": "econet-influxdb" },
        "type": "timeseries",
        "gridPos": { "h": 10, "w": 12, "x": 0, "y": 8 },
        "fieldConfig": {
          "defaults": {
            "unit": "celsius",
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10,
              "spanNulls": false
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "influxdb", "uid": "econet-influxdb" },
            "rawQuery": true,
            "resultFormat": "time_series",
            "alias": "$tag_entity_id",
            "query": "SELECT mean(\"value\") FROM \"°C\" WHERE $timeFilter AND (\"domain\" = 'sensor' AND \"entity_id\" = 'grant_aerona_heat_pump_heat_source_preset_temp') GROUP BY time($__interval), \"domain\", \"entity_id\" fill(null)"
          }
        ]
      },
      {
        "id": 3,
        "title": "Buffer Temperature",
        "datasource": { "type": "influxdb", "uid": "econet-influxdb" },
        "type": "timeseries",
        "gridPos": { "h": 10, "w": 12, "x": 12, "y": 8 },
        "fieldConfig": {
          "defaults": {
            "unit": "celsius",
            "custom": {
              "lineWidth": 2,
              "fillOpacity": 10,
              "spanNulls": false
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "influxdb", "uid": "econet-influxdb" },
            "rawQuery": true,
            "resultFormat": "time_series",
            "alias": "$tag_entity_id",
            "query": "SELECT mean(\"value\") FROM \"°C\" WHERE $timeFilter AND (\"domain\" = 'sensor' AND \"entity_id\" = 'grant_aerona_heat_pump_buffer_temp_lower') GROUP BY time($__interval), \"domain\", \"entity_id\" fill(null)"
          }
        ]
      },
      {
        "id": 4,
        "title": "Flow and Return Overview",
        "datasource": { "type": "influxdb", "uid": "econet-influxdb" },
        "type": "timeseries",
        "gridPos": { "h": 12, "w": 24, "x": 0, "y": 18 },
        "fieldConfig": {
          "defaults": {
            "unit": "celsius",
            "custom": {
              "lineWidth": 1,
              "fillOpacity": 5,
              "spanNulls": false
            }
          },
          "overrides": []
        },
        "targets": [
          {
            "refId": "A",
            "datasource": { "type": "influxdb", "uid": "econet-influxdb" },
            "rawQuery": true,
            "resultFormat": "time_series",
            "alias": "$tag_entity_id",
            "query": "SELECT mean(\"value\") FROM \"°C\" WHERE $timeFilter AND ((\"domain\" = 'sensor' AND \"entity_id\" = 'grant_aerona_heat_pump_flow_temperature') OR (\"domain\" = 'sensor' AND \"entity_id\" = 'grant_aerona_heat_pump_return_temperature')) GROUP BY time($__interval), \"domain\", \"entity_id\" fill(null)"
          }
        ]
      }
    ]
}
